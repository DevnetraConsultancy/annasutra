# AnnaSutra Environment Configuration Template
# Optional: Zero configuration is needed for local development (defaults to SQLite automatically).
# Copy this file to .env or .env.local to customize any settings.

DJANGO_SECRET_KEY=annasutra-insecure-example-key-for-local-development-only
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration:
# - Leave commented out for automatic zero-config local SQLite (backend/annasutra.sqlite3)
# - Or uncomment to connect to MySQL 8.0+ / Aiven Cloud / Docker:
# DATABASE_URL=mysql://annasutra:annasutra@localhost:3306/annasutra_db

# WebAuthn relying party configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AnnaSutra
WEBAUTHN_ORIGIN=http://localhost:8000

# OTP Provider: console (prints OTP in debug response & terminal) or android_gateway
OTP_PROVIDER=console
OTP_DEBUG=True
