# AnnaSutra Backend Environment Template
# NEVER place real secrets or production credentials in this file.
DEBUG=True
SECRET_KEY=django-insecure-dummy-dev-key-never-use-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://annasutra_user:fake_password@localhost:5432/annasutra_db

# SMS Provider (Dev stub)
SMS_PROVIDER=dummy
SMS_API_KEY=dummy_key_not_real

# Cloudflare & Domain
PUBLIC_DOMAIN=t.example.in
API_DOMAIN=api.example.in

# Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=annasutra-evidence-dev
OBJECT_STORAGE_ACCESS_KEY=fake_access_key
OBJECT_STORAGE_SECRET_KEY=fake_secret_key
